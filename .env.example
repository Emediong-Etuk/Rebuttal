# Copy to .env.local for local development. All values are server-side only.

# Postgres
DATABASE_URL=postgres://rebuttal:rebuttal@localhost:5432/rebuttal

# PayPal sandbox app (developer.paypal.com > Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID shown after registering the webhook URL (or printed by `npm run seed`)
PAYPAL_WEBHOOK_ID=

# Anthropic (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Fallback when there is no Anthropic key: Claude through OpenRouter (openrouter.ai > Keys).
# Check openrouter.ai/models for the newest Claude id, e.g. anthropic/claude-...
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5

# Telegram bot (talk to @BotFather) and the seller's chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: TELEGRAM_CHAT_ID can be left empty; POST /api/telegram/setup saves it after you /start the bot.
# Optional: TELEGRAM_WEBHOOK_SECRET defaults to a value derived from APPROVAL_SECRET.
TELEGRAM_WEBHOOK_SECRET=

# Public base URL of this app, used in approval links
APP_URL=http://localhost:3000
# Long random string for HMAC-signing approval links: `openssl rand -hex 32`
APPROVAL_SECRET=
# Protects /api/cron/* when triggered over HTTP
CRON_SECRET=

# Above this amount (in the dispute currency), conceding needs the seller to type the amount
CONCEDE_CAP=100
